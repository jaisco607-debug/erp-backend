# Copy to deploy/.env ON THE SERVER and fill in. Never commit the real file, never send it in chat.
# Make the secrets with:  openssl rand -hex 32   (run it twice: one for each secret, and once more for the DB password)

# Database (created by docker compose; the password is only used inside the server)
DB_USER=erp
DB_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE
DB_NAME=erp

# Login tokens: 32+ characters each, different from each other
JWT_ACCESS_SECRET=PUT_RANDOM_64_HEX_HERE
JWT_REFRESH_SECRET=PUT_ANOTHER_RANDOM_64_HEX_HERE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# The frontend address(es) that may call the API from a browser, exactly as typed in the browser, comma separated
# (https only, no trailing slash), for example: https://erp.example.com
CORS_ORIGINS=https://CHANGE_ME

# Real login safety values
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX=10
LOGIN_IP_WINDOW_MINUTES=15
LOG_LEVEL=info

# Copy this file to .env and fill in your own values. Never share .env.
NODE_ENV=development
PORT=3000

# PostgreSQL: postgres://USER:PASSWORD@HOST:5432/DATABASE
# Supabase: use the "Session pooler" string from Connect in the dashboard, e.g.
# postgres://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/erp_dev
# Set to true when the database server requires SSL (all cloud databases, incl. Supabase)
DATABASE_SSL=false
# Path to the provider's SSL certificate file, if it gives one (Supabase: Database settings > SSL certificate)
DATABASE_SSL_CA=

# Login tokens. Use long random strings, e.g. from: openssl rand -hex 32
# In production the server refuses to start with anything shorter than 32 characters.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend address(es) allowed to call the API from a browser, comma separated.
CORS_ORIGINS=http://localhost:5173

# Login safety: after LOGIN_MAX_FAILED wrong passwords the account is locked for LOGIN_LOCK_MINUTES.
# One IP may try LOGIN_IP_MAX logins per LOGIN_IP_WINDOW_MINUTES. Keep 5 / 15 / 10 / 15 for real use.
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX=10
LOGIN_IP_WINDOW_MINUTES=15

# Log level: error, warn, info, debug
LOG_LEVEL=info
